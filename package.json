{
  "name": "impulsopyme",
  "version": "1.0.0",
  "description": "ImpulsoPYME: gestión y análisis con IA para pequeños negocios colombianos (ventas, inventario, clientes, proveedores y pronóstico).",
  "author": "Samuel Salcedo <samuel.salcedo@campusucc.edu.co>",
  "license": "MIT",
  "private": true,
  "main": "electron/main.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "tokens": "node scripts/build-tokens.js",
    "build:css": "npm run tokens && tailwindcss -c tailwind.config.js -i public/css/src.css -o public/css/app.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.js -i public/css/src.css -o public/css/app.css --watch",
    "prestart": "npm run build:css",
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch server/index.js",
    "seed": "node --disable-warning=ExperimentalWarning server/seed/run.js",
    "test": "node --disable-warning=ExperimentalWarning --test",
    "electron": "npm run build:css && electron .",
    "dist": "npm run build:css && electron-builder",
    "dist:win": "npm run build:css && electron-builder --win",
    "dist:mac": "npm run build:css && electron-builder --mac",
    "icon": "node scripts/make-icon.js",
    "smoke": "node --disable-warning=ExperimentalWarning scripts/smoke.js"
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@fontsource/hanken-grotesk": "^5.3.0",
    "@fontsource/syne": "^5.3.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "tailwindcss": "^4.3.3"
  },
  "build": {
    "appId": "co.edu.ucc.impulsopyme",
    "productName": "ImpulsoPYME",
    "copyright": "Samuel Salcedo",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "server/**",
      "public/**",
      "package.json",
      "!**/*.map",
      "!public/css/src.css"
    ],
    "artifactName": "ImpulsoPYME-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "shortcutName": "ImpulsoPYME"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.business",
      "icon": "build/icon.png"
    },
    "dmg": {
      "title": "ImpulsoPYME ${version}"
    },
    "npmRebuild": false
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SamuelSalcedo22/impulsopyme.git"
  },
  "homepage": "https://github.com/SamuelSalcedo22/impulsopyme#readme",
  "bugs": {
    "url": "https://github.com/SamuelSalcedo22/impulsopyme/issues"
  },
  "keywords": [
    "pyme",
    "inventario",
    "ventas",
    "colombia",
    "vertex-ai",
    "electron",
    "pronostico"
  ]
}
