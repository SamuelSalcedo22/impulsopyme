# Copia este archivo como .env (cp .env.example .env) y ajusta lo que necesites.
# El archivo .env NUNCA se sube a GitHub.

# Puerto del servidor local (solo versión web; Electron elige uno libre)
PORT=3000

# --- Vertex AI (opcional: sin esto, el pronóstico y las alertas locales siguen funcionando) ---
# Región de Vertex AI
GOOGLE_CLOUD_LOCATION=us-central1
# Modelo de Gemini
VERTEX_MODEL=gemini-2.5-flash
# Si prefieres no subir la llave desde Ajustes, apunta aquí al JSON de tu cuenta de servicio:
# GOOGLE_APPLICATION_CREDENTIALS=./credentials/vertex-key.json
# GOOGLE_CLOUD_PROJECT=tu-proyecto
