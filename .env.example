# Copia este archivo como .env y completa los valores. El archivo .env nunca se sube a GitHub.

# Base de datos PostgreSQL. En tu computador puede ser una base gratuita de Neon (otra distinta a la del servidor)
# o un Postgres local. Ejemplo de Neon: postgresql://usuario:clave@ep-xxxx.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/impulsopyme

# Opcional: las pruebas (npm test) usan esta base; cada archivo trabaja en un esquema temporal que se borra solo.
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/impulsopyme_test

# Secreto para firmar las sesiones. En el servidor es obligatorio y debe ser largo y aleatorio.
# JWT_SECRET=

# Vertex AI: pega aquí el contenido completo del JSON de la cuenta de servicio (en una sola línea) o en base64.
# GOOGLE_CREDENTIALS_JSON=
GOOGLE_CLOUD_LOCATION=us-central1
VERTEX_MODEL=gemini-2.5-flash

# Opcional: crea esta cuenta con datos de ejemplo cuando la base está vacía (útil para quien evalúa la app).
# DEMO_USERNAME=profesor
# DEMO_PASSWORD=
# DEMO_BUSINESS_TYPE=tienda_barrio
