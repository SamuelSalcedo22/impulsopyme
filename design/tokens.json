{
  "$description": "Design tokens de ImpulsoPYME. Tres niveles: global (valores crudos), semantic (propósito en la UI) y component (específicos). Las referencias usan la forma {nivel.grupo.nombre}.",
  "global": {
    "color": {
      "anthracite": {
        "950": "#121315",
        "900": "#18191B",
        "800": "#1D1E21",
        "700": "#222428",
        "600": "#2C2E33",
        "500": "#3A3D43",
        "400": "#5A5E66"
      },
      "cream": {
        "50": "#FBF7F3",
        "100": "#F4EEE8",
        "300": "#CFC6BD",
        "500": "#9C948C",
        "700": "#6F6962"
      },
      "ember": {
        "300": "#F29A78",
        "400": "#EA7448",
        "500": "#E05326",
        "600": "#BE4118",
        "700": "#8F3010"
      },
      "lime": {
        "300": "#DDF7C4",
        "500": "#C8F0A8",
        "700": "#7FBF4D"
      },
      "amber": {
        "400": "#F7D154",
        "500": "#F2C230",
        "700": "#B88E10"
      },
      "sky": {
        "400": "#7FB4F2",
        "500": "#5B9BEA"
      },
      "rose": {
        "400": "#F28A9B",
        "500": "#E8586F"
      },
      "white": "#FFFFFF",
      "black": "#000000"
    },
    "space": {
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "5": "20px",
      "6": "24px",
      "8": "32px",
      "10": "40px",
      "12": "48px",
      "16": "64px"
    },
    "radius": {
      "sm": "10px",
      "md": "16px",
      "lg": "24px",
      "xl": "32px",
      "pill": "999px"
    },
    "font": {
      "display": "'Manrope', system-ui, -apple-system, 'Segoe UI', sans-serif",
      "body": "'Manrope', system-ui, -apple-system, 'Segoe UI', sans-serif"
    },
    "size": {
      "xs": "0.75rem",
      "sm": "0.875rem",
      "md": "1rem",
      "lg": "1.25rem",
      "xl": "1.75rem",
      "2xl": "2.5rem",
      "3xl": "3.5rem"
    },
    "duration": {
      "fast": "140ms",
      "base": "240ms",
      "slow": "480ms"
    },
    "blur": {
      "glass": "22px",
      "heavy": "38px"
    }
  },
  "semantic": {
    "color": {
      "background": {
        "base": "{global.color.anthracite.900}",
        "raised": "{global.color.anthracite.700}",
        "sunken": "{global.color.anthracite.950}",
        "glow": "{global.color.ember.500}",
        "gradient-from": "{global.color.anthracite.900}",
        "gradient-to": "{global.color.anthracite.700}"
      },
      "surface": {
        "glass": "rgba(255,255,255,0.055)",
        "glass-strong": "rgba(255,255,255,0.09)",
        "glass-border": "rgba(255,255,255,0.12)",
        "rail": "{global.color.anthracite.950}",
        "overlay": "rgba(29,30,33,0.96)",
        "scrim": "rgba(0,0,0,0.6)",
        "highlight": "rgba(255,255,255,0.06)",
        "shadow": "rgba(0,0,0,0.65)",
        "scrollbar": "{global.color.anthracite.500}",
        "option": "{global.color.anthracite.700}"
      },
      "text": {
        "primary": "{global.color.cream.100}",
        "secondary": "{global.color.cream.300}",
        "muted": "{global.color.cream.500}",
        "inverse": "{global.color.anthracite.900}",
        "positive": "{global.color.lime.500}",
        "negative": "{global.color.rose.400}",
        "warning": "{global.color.amber.400}",
        "accent": "{global.color.ember.300}"
      },
      "action": {
        "primary": "{global.color.ember.500}",
        "primary-hover": "{global.color.ember.400}",
        "primary-active": "{global.color.ember.600}",
        "on-light": "{global.color.cream.50}",
        "focus": "{global.color.amber.400}",
        "secondary": "{global.color.cream.50}",
        "secondary-hover": "{global.color.white}",
        "on-secondary": "{global.color.anthracite.900}"
      },
      "data": {
        "series-1": "{global.color.amber.500}",
        "series-2": "{global.color.cream.100}",
        "series-3": "{global.color.ember.400}",
        "series-4": "{global.color.sky.400}",
        "positive": "{global.color.lime.500}",
        "negative": "{global.color.rose.400}",
        "grid": "rgba(255,255,255,0.07)",
        "track": "rgba(255,255,255,0.06)",
        "crosshair": "rgba(255,255,255,0.3)",
        "dot-ring": "{global.color.anthracite.900}"
      }
    },
    "radius": {
      "card": "{global.radius.xl}",
      "control": "{global.radius.md}",
      "chip": "{global.radius.pill}"
    },
    "space": {
      "card-padding": "{global.space.6}",
      "page-gutter": "{global.space.8}",
      "stack": "{global.space.4}"
    }
  },
  "component": {
    "button": {
      "primary": {
        "bg": {
          "default": "{semantic.color.action.primary}",
          "hover": "{semantic.color.action.primary-hover}",
          "active": "{semantic.color.action.primary-active}"
        },
        "fg": {
          "default": "{semantic.color.action.on-light}"
        }
      },
      "light": {
        "bg": {
          "default": "{semantic.color.action.secondary}",
          "hover": "{semantic.color.action.secondary-hover}"
        },
        "fg": {
          "default": "{semantic.color.action.on-secondary}"
        }
      },
      "ghost": {
        "bg": {
          "default": "{semantic.color.surface.glass}",
          "hover": "{semantic.color.surface.glass-strong}"
        },
        "fg": {
          "default": "{semantic.color.text.primary}"
        }
      },
      "radius": "{semantic.radius.chip}"
    },
    "card": {
      "bg": "{semantic.color.surface.glass}",
      "border": "{semantic.color.surface.glass-border}",
      "radius": "{semantic.radius.card}",
      "padding": "{semantic.space.card-padding}"
    },
    "input": {
      "bg": "{semantic.color.surface.glass}",
      "border": "{semantic.color.surface.glass-border}",
      "border-focus": "{semantic.color.action.focus}",
      "radius": "{semantic.radius.control}"
    },
    "sidebar": {
      "bg": "{semantic.color.surface.rail}",
      "item-active-bg": "{semantic.color.surface.glass-strong}",
      "width": "84px",
      "width-expanded": "248px"
    }
  },
  "$themes": "'theme.light' redefine solo tokens semánticos para el modo claro (papel cálido con el mismo brillo ember). Los componentes los heredan.",
  "theme": {
    "light": {
      "color": {
        "background": {
          "base": "#F5EFE8",
          "raised": "#FFFFFF",
          "sunken": "#ECE4DA",
          "glow": "{global.color.ember.500}",
          "gradient-from": "#F8F3ED",
          "gradient-to": "#EEE6DC"
        },
        "surface": {
          "glass": "rgba(255,255,255,0.62)",
          "glass-strong": "rgba(255,255,255,0.92)",
          "glass-border": "rgba(60,38,22,0.11)",
          "rail": "rgba(255,255,255,0.74)",
          "overlay": "rgba(255,252,248,0.97)",
          "scrim": "rgba(40,26,16,0.32)",
          "highlight": "rgba(255,255,255,0.9)",
          "shadow": "rgba(90,50,20,0.16)",
          "scrollbar": "{global.color.cream.300}",
          "option": "{global.color.white}"
        },
        "text": {
          "primary": "{global.color.anthracite.800}",
          "secondary": "#4F4A44",
          "muted": "#7B736B",
          "inverse": "{global.color.cream.50}",
          "positive": "#3B7A26",
          "negative": "#BF3550",
          "warning": "#8A6400",
          "accent": "{global.color.ember.600}"
        },
        "action": {
          "primary": "{global.color.ember.500}",
          "primary-hover": "{global.color.ember.600}",
          "primary-active": "{global.color.ember.700}",
          "on-light": "{global.color.cream.50}",
          "focus": "{global.color.ember.600}",
          "secondary": "{global.color.anthracite.800}",
          "secondary-hover": "{global.color.anthracite.700}",
          "on-secondary": "{global.color.cream.50}"
        },
        "data": {
          "series-1": "#D19C00",
          "series-2": "{global.color.anthracite.700}",
          "series-3": "{global.color.ember.500}",
          "series-4": "{global.color.sky.500}",
          "positive": "#4C9A32",
          "negative": "{global.color.rose.500}",
          "grid": "rgba(60,38,22,0.09)",
          "track": "rgba(60,38,22,0.08)",
          "crosshair": "rgba(60,38,22,0.35)",
          "dot-ring": "{global.color.white}"
        }
      }
    }
  }
}
